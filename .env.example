# ==========================================
# 프로젝트 기본 정보
# ==========================================
# 지정하지 않으면 현재 디렉터리 이름이 Docker Compose 프로젝트명으로 자동 사용됩니다.
# COMPOSE_PROJECT_NAME=my-project
ENVIRONMENT=development

# ==========================================
# Frontend 설정
# ==========================================
FRONTEND_PORT=5173
CHOKIDAR_USEPOLLING=true

# ==========================================
# Backend & API 설정
# ==========================================
BACKEND_PORT=8000
SECRET_KEY=replace_with_a_secure_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# PostgreSQL Database 설정
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_local_dev_password@db:5432/app_db

# ==========================================
# 보안 및 마스터 암호화 키 (AES-256-GCM, 32바이트 Base64)
# ==========================================
MASTER_ENCRYPTION_KEY=replace_with_32_byte_base64_encoded_key_here
